{
  "name": "json-translator",
  "version": "0.0.0",
  "description": "JSON translator GUI",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "monaco-editor": "^0.57.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "yaml": "^2.9.1"
  },
  "author": "29kiyo",
  "homepage": "https://github.com/29kiyo/json-translator",
  "repository": {
    "type": "git",
    "url": "https://github.com/29kiyo/json-translator.git"
  }
}
